  "dailyChecklist": [
    "官方：小鹏汽车/XPeng 微博、APP 是否更新 L03 周期或交付战报",
    "产能：L03 周交付/月交付、集团月交付、工厂改造/投产节点",
    "车友：同配置 1330 Max 是否出现新的配车/提车样本（至少 1 条）",
    "风险：春节排产、出口分流、芯片/供应链、L05 是否影响 L03",
    "更新：把新样本/信源写入 data.json，运行 python update.py 重建"
  ],
  "methodology": {
    "summary": "把官方周期、同配置车友样本、产能/供需三类证据加权，再用春节把分布切成“年前/年后”两段。输出的是概率区间，不是单点承诺。",
    "formula": "先验 = 官方 11–16 周（55%）+ 同配置样本 12.6 周（25%）+ 产能/供需 13.1 周（20%）+ 颜色/城市/出口/L05 修正；春节前后分别建模。",
    "rules": [
      "官方窗口权重最高，因为它是小鹏真实排产口径；但不把 APP 上限当作保证。",
      "车友样本只在“同动力 + 同配置 + 已完成”时计入，且权重压低，避免小样本过拟合。",
      "产能看 L03 自身月交付，而不是集团总交付；集团总交付会被 GX/G9L/L05 等车型稀释。",
      "春节是硬约束：窗口跨春节时，年前/年后会出现明显断档，不能简单取中点。",
      "所有第三方产能测算都标注“非官方”，不与官方口径混用。"
    ],
    "caveats": [
      "车友样本来自公开社区，存在幸存者偏差：提前提车的人更愿意发帖。",
      "颜色/配置会影响批次；新月银、18 英寸的样本不足，修正幅度刻意保守。",
      "出口占比、芯片供应、L05 订单分流都可能让实际日期偏离 1–2 周。",
      "交付中心所在城市、尾款/保险/上牌准备也会影响“下线→提车”的 3–7 天。"
    ]
  },
